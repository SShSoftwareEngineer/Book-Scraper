# === Project settings ===
BASE_URL= # Base URL for parsing
MAX_PAGE_PER_CATEGORY= # Maximum pages per category for search, 0 or None for unlimited
BATCH_SIZE= # Batch buffer size
COLLECT_INTERVAL= # Results collection interval in seconds
MAX_RETRIES= # Maximum task retries
WORKER_COUNT= # Number of scraping workers

# === PostgreSQL settings ===
DB_NAME= # Database name
DB_HOST= # Database host
DB_PORT= # Database port
DB_USER= # User name
DB_PASSWORD= # User password

# === Redis settings ===
REDIS_HOST= # Redis host
REDIS_PORT= # Redis port
REDIS_BROKER_DB=0# Redis for broker ID
REDIS_BACKEND_DB=1# Redis for backend ID
REDIS_CACHE_DB=2# Redis for cache ID

# === Celery settings ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL_WORKER= # Log level for Celery workers (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL_BEAT= # Log level for Celery beat (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL_FLOWER= # Log level for Flower (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Flower
FLOWER_PORT=5555
